<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>testbed_hardware_interfaces</name>
  <version>0.0.1</version>
  <description>Hardware interfaces for the testbed project</description>
  <maintainer email="ariel.rodriguezjimenez@nct-dresden.de">Ariel Rodriguez Jimenez</maintainer>
  <maintainer email="lorenzo.mazza@nct-dresden.de">Lorenzo Mazza</maintainer>
  <license>Apache License 2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- ROS 2 dependencies -->
  <depend>rclcpp</depend>
  <depend>kdl_parser</depend>
  <depend>urdf</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>

  <!-- Message dependencies -->
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>testbed_msgs</depend>

  <!-- Solver dependencies -->
  <depend>rcm_solvers</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
