<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>testbed_joint_rcm_controller</name>
  <version>0.0.1</version>
  <description>Velocity joint controller with RCM constraints</description>
  <maintainer email="ariel.rodriguezjimenez@nct-dresden.de">Ariel Rodriguez</maintainer>
  <maintainer email="lorenzo.mazza@nct-dresden.de">Lorenzo Mazza</maintainer>
  <license>Apache License 2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- ROS 2 dependencies -->
  <depend>rclcpp</depend>
  <depend>realtime_tools</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>controller_interface</depend>
  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>

  <!-- Message dependencies -->
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>testbed_msgs</depend>

  <!-- Robot dependencies -->
  <depend>testbed_hardware_interfaces</depend>

  <!-- Parameter and solver dependencies -->
  <depend>generate_parameter_library</depend>
  <depend>parameter_traits</depend>
  <depend>rcm_solvers</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <controller_interface plugin="${prefix}/testbed_joint_rcm_controller.xml"/>
  </export>
</package>