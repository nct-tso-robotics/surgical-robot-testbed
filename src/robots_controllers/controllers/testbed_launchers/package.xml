<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>testbed_launchers</name>
  <version>0.0.1</version>
  <description>Launch files for testbed controllers and broadcasters</description>
  <maintainer email="ariel.rodriguezjimenez@nct-dresden.de">Ariel Rodriguez</maintainer>
  <maintainer email="lorenzo.mazza@nct-dresden.de">Lorenzo Mazza</maintainer>
  <license>MIT</license>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>launch</depend>
  <depend>launch_ros</depend>
  <depend>testbed_broadcasters</depend>
  <depend>testbed_joint_rcm_controller</depend>
  <!-- UR driver is needed only by the physical UR launch. -->
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>hardware_interface</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>testbed_msgs</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
