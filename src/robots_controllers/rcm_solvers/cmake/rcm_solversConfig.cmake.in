@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(Eigen3)
find_dependency(orocos_kdl)
include("${CMAKE_CURRENT_LIST_DIR}/rcm_solversTargets.cmake")
set(rcm_solvers_LIBRARIES rcm_solvers::rcm_solvers)
set_and_check(rcm_solvers_INCLUDE_DIRS "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@")
set_and_check(rcm_solvers_LIBRARY_DIRS "@PACKAGE_CMAKE_INSTALL_LIBDIR@")
check_required_components(rcm_solvers)
